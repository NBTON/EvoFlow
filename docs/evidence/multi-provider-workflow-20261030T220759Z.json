          "title": "Reconcile Orders with Counted Shipments and Inventory Availability",
          "query": "",
          "program": [
            {
              "op": "deduplicate",
              "input": "orders",
              "as": "orders_dedup"
            },
            {
              "op": "deduplicate",
              "input": "shipments",
              "as": "shipments_dedup"
            },
            {
              "op": "filter_in",
              "input": "shipments_dedup",
              "field": "status",
              "values": [
                "shipped",
                "delivered"
              ],
              "as": "shipments_counted"
            },
            {
              "op": "project",
              "input": "shipments_counted",
              "columns": [
                "order_id",
                "shipment_id",
                "quantity"
              ],
              "as": "shipments_proj"
            },
            {
              "op": "deduplicate",
              "input": "shipments_proj",
              "as": "shipments_unique"
            },
            {
              "op": "group_sum",
              "input": "shipments_unique",
              "keys": [
                "order_id"
              ],
              "field": "quantity",
              "output": "shipped",
              "as": "shipped_by_order"
            },
            {
              "op": "deduplicate",
              "input": "inventory",
              "as": "inventory_dedup"
            },
            {
              "op": "group_sum",
              "input": "inventory_dedup",
              "keys": [
                "sku",
                "warehouse"
              ],
              "field": "available_qty",
              "output": "available_qty_total",
              "as": "inventory_agg"
            },
            {
              "op": "left_join",
              "input": "orders_dedup",
              "right": "shipped_by_order",
              "on": {
                "order_id": "order_id"
              },
              "fields": {
                "shipped": "shipped"
              },
              "as": "orders_shipped"
            },
            {
              "op": "left_join",
              "input": "orders_shipped",
              "right": "inventory_agg",
              "on": {
                "sku": "sku",
                "warehouse": "warehouse"
              },
              "fields": {
                "available_qty": "available_qty_total"
              },
              "as": "orders_inventory"
            },
            {
              "op": "derive",
              "input": "orders_inventory",
              "values": {
                "ordered": "quantity",
                "shipped": "coalesce(shipped, 0)",
                "remaining": "max(0, ordered - shipped)",
