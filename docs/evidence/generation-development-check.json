  "plan": {
    "title": "Order Reconciliation Program",
    "query": "",
    "program": [
      {
        "op": "deduplicate",
        "input": "orders",
        "as": "orders_dedup"
      },
      {
        "op": "deduplicate",
        "input": "shipments",
        "as": "shipments_dedup"
      },
      {
        "op": "deduplicate",
        "input": "inventory",
        "as": "inventory_dedup"
      },
      {
        "op": "filter_in",
        "input": "shipments_dedup",
        "as": "shipments_filtered",
        "field": "status",
        "values": [
          "shipped",
          "delivered"
        ]
      },
      {
        "op": "group_sum",
        "input": "shipments_filtered",
        "as": "shipments_agg",
        "keys": [
          "order_id"
        ],
        "field": "quantity",
        "output": "shipped"
      },
      {
        "op": "left_join",
        "input": "orders_dedup",
        "as": "orders_with_shipments",
        "right": "shipments_agg",
        "on": {
          "order_id": "order_id"
        },
        "fields": {
          "shipped": "shipped"
        }
      },
      {
        "op": "derive",
        "input": "orders_with_shipments",
        "as": "orders_shipped_filled",
        "values": {
          "shipped": "coalesce(shipped, 0)"
        }
      },
      {
        "op": "left_join",
        "input": "orders_shipped_filled",
        "as": "orders_with_inventory",
        "right": "inventory_dedup",
        "on": {
          "sku": "sku",
          "warehouse": "warehouse"
        },
        "fields": {
          "available_qty": "available_qty"
        }
      },
      {
        "op": "derive",
        "input": "orders_with_inventory",
        "as": "orders_computed",
        "values": {
          "ordered": "quantity",
          "remaining": "max(0, ordered - shipped)",
          "delayed": "1 if (remaining > 0 and days_between(as_of, promised_date) > grace_days) else 0",
          "cause": "('complete' if remaining == 0 else ('inventory_unknown' if available_qty is None else ('stock_shortage' if available_qty < remaining else 'fulfillment_pending')))"
        }
      },
      {
        "op": "project",
        "input": "orders_computed",
        "as": "final_result",
        "columns": [
          "order_id",
          "warehouse",
          "ordered",
          "shipped",
          "remaining",
          "delayed",
          "cause"
        ]
      }
    ],
    "summary": "Reconciles orders with shipments and inventory to compute shipped quantities, remaining quantities, delay status, and fulfillment cause per order."
  },
