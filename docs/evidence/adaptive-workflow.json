      "report": "# EvoFlow reconciliation\n\nLive execution; independently verified.\nOrders: 12 | Delayed: 6 | Incomplete: 9\n\nOrder-level results.\n\n| Order | Warehouse | Ordered | Shipped | Remaining | Delayed | Evidence-based cause |\n|---|---|---:|---:|---:|---|---|\n| ORD-17-000 | Riyadh | 16 | 16 | 0 | No | complete |\n| ORD-17-001 | Jeddah | 12 | 5 | 7 | Yes | fulfillment_pending |\n| ORD-17-002 | Dammam | 8 | 4 | 4 | No | stock_shortage |\n| ORD-17-003 | Riyadh | 3 | 0 | 3 | Yes | fulfillment_pending |\n| ORD-17-004 | Jeddah | 16 | 16 | 0 | No | complete |\n| ORD-17-005 | Dammam | 13 | 10 | 3 | No | inventory_unknown |\n| ORD-17-006 | Riyadh | 15 | 2 | 13 | Yes | fulfillment_pending |\n| ORD-17-007 | Jeddah | 4 | 1 | 3 | Yes | fulfillment_pending |\n| ORD-17-008 | Dammam | 7 | 7 | 0 | No | complete |\n| ORD-17-009 | Riyadh | 9 | 5 | 4 | Yes | fulfillment_pending |\n| ORD-17-010 | Jeddah | 6 | 5 | 1 | Yes | inventory_unknown |\n| ORD-17-011 | Dammam | 5 | 2 | 3 | No | fulfillment_pending |",
      "grouped_by_warehouse": false,
      "evidence_ids": [],
      "reused": false,
      "plan": {
        "title": "Order Shipment Inventory Reconciliation",
        "query": "",
        "program": [
          {
            "op": "deduplicate",
            "input": "orders",
            "as": "orders_dedup"
          },
          {
            "op": "deduplicate",
            "input": "shipments",
            "as": "shipments_dedup"
          },
          {
            "op": "deduplicate",
            "input": "inventory",
            "as": "inventory_dedup"
          },
          {
            "op": "filter_in",
            "input": "shipments_dedup",
            "as": "shipments_filtered",
            "field": "status",
            "values": [
              "shipped",
              "delivered"
            ]
          },
          {
            "op": "group_sum",
            "input": "shipments_filtered",
            "as": "shipments_agg",
            "keys": [
              "order_id"
            ],
            "field": "quantity",
            "output": "shipped_qty"
          },
          {
            "op": "left_join",
            "input": "orders_dedup",
            "as": "orders_shipped",
            "right": "shipments_agg",
            "on": {
              "order_id": "order_id"
            },
            "fields": {
              "shipped": "shipped_qty"
            }
          },
          {
            "op": "left_join",
            "input": "orders_shipped",
            "as": "orders_inv",
            "right": "inventory_dedup",
            "on": {
              "sku": "sku",
              "warehouse": "warehouse"
            },
            "fields": {
              "available_qty": "available_qty"
            }
          },
          {
            "op": "derive",
            "input": "orders_inv",
            "as": "orders_calc",
            "values": {
              "ordered": "quantity",
              "shipped": "coalesce(shipped, 0)",
              "remaining": "max(0, ordered - shipped)",
              "delayed": "1 if remaining > 0 and days_between(as_of, promised_date) > grace_days else 0",
              "cause": "'complete' if remaining == 0 else ('inventory_unknown' if available_qty is None else ('stock_shortage' if available_qty < remaining else 'fulfillment_pending'))"
            }
          },
          {
            "op": "project",
            "input": "orders_calc",
            "as": "final",
            "columns": [
              "order_id",
              "warehouse",
              "ordered",
              "shipped",
              "remaining",
              "delayed",
              "cause"
            ]
          }
        ],
        "summary": "Deduplicate inputs, filter counted shipments, aggregate per order, join with inventory, compute shipped, remaining, delayed, and cause per order."
      },
