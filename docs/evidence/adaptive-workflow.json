          },
          {
            "op": "deduplicate",
            "input": "inventory",
            "as": "inventory_dedup"
          },
          {
            "op": "filter_in",
            "input": "shipments_dedup",
            "as": "shipments_filtered",
            "field": "status",
            "values": [
              "shipped",
              "delivered"
            ]
          },
          {
            "op": "group_sum",
            "input": "shipments_filtered",
            "as": "shipments_agg",
            "keys": [
              "order_id"
            ],
            "field": "quantity",
            "output": "shipped_qty"
          },
          {
            "op": "left_join",
            "input": "orders_dedup",
            "as": "orders_shipped",
            "right": "shipments_agg",
            "on": {
              "order_id": "order_id"
            },
            "fields": {
              "shipped": "shipped_qty"
            }
          },
          {
            "op": "left_join",
            "input": "orders_shipped",
            "as": "orders_inv",
            "right": "inventory_dedup",
            "on": {
              "sku": "sku",
              "warehouse": "warehouse"
            },
            "fields": {
              "available_qty": "available_qty"
            }
          },
          {
            "op": "derive",
            "input": "orders_inv",
            "as": "orders_calc",
            "values": {
              "ordered": "quantity",
              "shipped": "coalesce(shipped, 0)",
              "remaining": "max(0, ordered - shipped)",
              "delayed": "1 if remaining > 0 and days_between(as_of, promised_date) > grace_days else 0",
              "cause": "'complete' if remaining == 0 else ('inventory_unknown' if available_qty is None else ('stock_shortage' if available_qty < remaining else 'fulfillment_pending'))"
            }
          },
          {
            "op": "project",
            "input": "orders_calc",
            "as": "final",
            "columns": [
              "order_id",
              "warehouse",
              "ordered",
              "shipped",
              "remaining",
              "delayed",
              "cause"
            ]
          }
        ],
