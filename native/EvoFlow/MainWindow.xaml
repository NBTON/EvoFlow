<Window x:Class="EvoFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EvoFlow">
 <Border x:Name="Shell" RequestedTheme="Dark" Background="{ThemeResource CompanionSurfaceBrush}" BorderBrush="{ThemeResource CompanionStrokeBrush}" BorderThickness="0" CornerRadius="0,0,22,22" PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
  <Grid x:Name="Root" KeyDown="OnKeyDown">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="ThinkingGlow" IsHitTestVisible="False" Visibility="Collapsed" CornerRadius="0,0,20,20" Opacity="0.18">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop x:Name="GlowStart" Color="Transparent" Offset="-0.4"/><GradientStop x:Name="GlowCenter" Color="#39D982" Offset="-0.2"/><GradientStop x:Name="GlowEnd" Color="Transparent" Offset="0"/></LinearGradientBrush></Border.Background>
   </Border>
   <Button x:Name="Pill" Click="ToggleExpanded" Height="40" Margin="2,0" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="0,0,20,20" Padding="14,0" UseSystemFocusVisuals="True" AutomationProperties.Name="EvoFlow, open task panel" AutomationProperties.AutomationId="Pill" ToolTipService.ToolTip="Hover to preview · click to keep open · Escape to collapse">
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Source="Assets/AppIcon.png" Width="22" Height="22" AutomationProperties.AccessibilityView="Raw"/>
     <TextBlock Grid.Column="1" Text="EvoFlow" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock x:Name="PillStatus" Grid.Column="2" Text="Starting" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="PillStatus" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </Button>
   <Grid x:Name="Body" Grid.Row="1" Visibility="Collapsed" Margin="20,0,20,16" RowSpacing="10" PointerPressed="OnBodyInteraction">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="Conversation" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button x:Name="NewChatButton" Grid.Column="1" Click="NewChat" IsEnabled="False" AutomationProperties.Name="New Chat" AutomationProperties.AutomationId="NewChatButton" ToolTipService.ToolTip="New Chat" Padding="8,6"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
     <Button x:Name="ChatHistoryButton" Grid.Column="2" Click="ShowChatHistory" IsEnabled="False" AutomationProperties.Name="Chat history" AutomationProperties.AutomationId="ChatHistoryButton" ToolTipService.ToolTip="Chat history" Padding="8,6"><FontIcon Glyph="&#xE81C;" FontSize="14"/></Button>
     <Button Grid.Column="3" Click="ShowMemory" AutomationProperties.Name="Memory and learned skills" AutomationProperties.AutomationId="BrainButton" Padding="10,6"><TextBlock Text="Memory"/></Button>
     <Button Grid.Column="4" Click="ShowSettings" Content="Settings" AutomationProperties.AutomationId="SettingsButton" Padding="10,6"/>
     <ToggleButton x:Name="PinButton" Grid.Column="5" Checked="PinChanged" Unchecked="PinChanged" AutomationProperties.Name="Keep task panel open" AutomationProperties.AutomationId="PinButton" Padding="8,6"><FontIcon Glyph="&#xE718;" FontSize="14"/></ToggleButton>
    </Grid>
    <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ConversationScroll">
     <StackPanel x:Name="Conversation" Spacing="12" Padding="0,4,8,4">
      <TextBlock x:Name="WelcomeText" Text="How can I help you today?" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="6">
     <ScrollViewer x:Name="ApprovalsScroll" Visibility="Collapsed" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ToolApprovals">
      <StackPanel x:Name="ApprovalItems" Spacing="8"/>
     </ScrollViewer>
     <StackPanel x:Name="WorkingPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
      <ProgressRing x:Name="WorkingRing" Width="18" Height="18" IsActive="False"/>
      <TextBlock x:Name="WorkingText" Text="Working…" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkingText" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="TaskText" PreviewKeyDown="OnTaskKeyDown" Header="Message" AcceptsReturn="True" MinHeight="74" MaxHeight="110" MaxLength="12000" TextWrapping="Wrap" PlaceholderText="Ask EvoFlow anything..." AutomationProperties.Name="Task instructions" AutomationProperties.AutomationId="TaskText"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
       <Button x:Name="RunButton" Content="Run task" Click="RunTask" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" AutomationProperties.AutomationId="RunButton"/>
       <Button x:Name="CancelButton" Content="Cancel" Click="CancelTask" Visibility="Collapsed" IsEnabled="False" AutomationProperties.AutomationId="CancelButton"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="InteractionHint" Text="Enter to send · Shift+Enter for a new line" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="False" IsClosable="True" Severity="Informational" AutomationProperties.AutomationId="Notice"/>
   </Grid>
  </Grid>
 </Border>
</Window>
