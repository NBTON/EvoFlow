# EvoFlow provider configuration example.
#
# The worker never reads this file. Copy values into
#   %LOCALAPPDATA%\EvoFlow\provider-keys.env
# (or point EVOFLOW_KEYS_FILE at another path for testing). Values are plain
# literals: no quoting tricks, expansion or export prefixes are parsed.
# Leave a key blank to keep the existing Windows DPAPI-protected credential.
# Only these names are accepted; unknown lines fail safely before any import.

# OpenRouter key used for Joey Decisions, GPT-6 Luna, and the legacy free gateway.
# Configured model usage may be paid; no automatic generator substitution.
OPENROUTER_API_KEY=

# DeepSeek key for the deepseek adapter slot.
DEEPSEEK_API_KEY=

# MiMo (Xiaomi) key. Base URL must be exactly one of:
#   https://token-plan-sgp.xiaomimimo.com/v1
#   https://api.xiaomimimo.com/v1
# Choose the route matching your account. Standard sk- keys use api.xiaomimimo.com;
# Token Plan tp-/ttp- keys use the account's assigned Token Plan route.
# A blank base URL uses the Singapore Token Plan default.
MIMO_API_KEY=
MIMO_BASE_URL=

# Optional LangSmith monitoring. Nonempty keys import into Windows DPAPI.
# Set LANGSMITH_TRACING=true locally to opt in; missing/blank stays disabled.
# Project defaults to EvoFlow; endpoint defaults to https://api.smith.langchain.com.
# EU workspaces use https://eu.api.smith.langchain.com. Workspace UUID is optional.
# Monitoring sends operational metadata, never prompts, datasets or tool payloads.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
